---

<div class="modal" id="modal" hidden>
  <div class="modal-card">
    <h2 id="modalTitle">Round complete!</h2>
    <p class="modal-score" id="modalScore"></p>
    <p class="modal-sub" id="modalSub"></p>
    <div class="modal-missed" id="modalMissed"></div>
    <div class="modal-actions">
      <button class="primary" id="modalAgain">Play again</button>
      <button class="ghost" id="modalClose">Close</button>
    </div>
  </div>
</div>
